# Copy this file to `.env` and fill in the two values from
# Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Hide a sign-in button until that provider is set up in Supabase (true by default).
# Apple needs a paid Apple Developer account, so you may want to start with it off.
VITE_AUTH_GOOGLE=true
VITE_AUTH_APPLE=false
VITE_AUTH_EMAIL=true
# the emailed one-time code; needs custom SMTP in Supabase (its built-in sender only reaches your team)
VITE_AUTH_EMAIL_CODE=false

